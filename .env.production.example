NODE_ENV=production
COMPOSE_PROJECT_NAME=omoney
PUBLIC_WEB_URL=https://omoney.online
PUBLIC_ADMIN_URL=https://admin.omoney.online
PUBLIC_API_URL=https://api.omoney.online
NEXT_PUBLIC_WEB_URL=https://omoney.online
NEXT_PUBLIC_ADMIN_URL=https://admin.omoney.online
NEXT_PUBLIC_API_URL=https://api.omoney.online
API_INTERNAL_URL=http://api:4000

POSTGRES_DB=omoney
POSTGRES_USER=omoney_user
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_INITDB_ARGS=--data-checksums
DATABASE_URL=postgresql://omoney_user:replace-with-long-random-password@postgres:5432/omoney?schema=public

REDIS_URL=redis://redis:6379/0

JWT_ACCESS_SECRET=replace-with-random-64-char-access-secret
JWT_REFRESH_SECRET=replace-with-different-random-64-char-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

COOKIE_DOMAIN=.omoney.online
COOKIE_SECURE=true
CORS_ORIGINS=https://omoney.online,https://www.omoney.online,https://admin.omoney.online
ADMIN_COOKIE_DOMAIN=.omoney.online
TRUST_PROXY=true

API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001

UPLOAD_STORAGE_DRIVER=local
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
MEDIA_ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/webm
RUN_SEED_ON_STARTUP=false

SEED_SUPER_ADMIN_EMAIL=info@omoney.online
SEED_SUPER_ADMIN_PASSWORD=replace-before-first-login
SEED_SUPER_ADMIN_NAME=OMoney Admin
PUBLIC_WHATSAPP_NUMBER=96896129711
PUBLIC_WHATSAPP_MESSAGE_URL=https://wa.me/message/3IRFY6VEC7GCG1
PUBLIC_SUPPORT_EMAIL=info@omoney.online
PUBLIC_COMPANY_NAME=OMoney
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
ADMIN_RATE_LIMIT_MAX_REQUESTS=30
EXCHANGE_RATE_DEFAULT_PROVIDER=navasan
EXCHANGE_RATE_FALLBACK_PROVIDER=manual
EXCHANGE_RATE_REFRESH_SEC=60
EXCHANGE_RATE_STALE_AFTER_SEC=300
EXCHANGE_RATE_CACHE_TTL_SEC=600
EXCHANGE_RATE_BUY_MARKUP_PERCENT=0.75
EXCHANGE_RATE_SELL_MARKUP_PERCENT=0.75
NAVASAN_HOURLY_LIMIT=42
NAVASAN_DAILY_LIMIT=1000
NAVASAN_MONTHLY_LIMIT=30000
NAVASAN_ENABLED=true
NAVASAN_API_URL=http://api.navasan.tech/latest/
NAVASAN_API_KEY=
NAVASAN_RATE_UNIT=toman
MANUAL_USD_TOMAN=
MANUAL_CAD_TOMAN=
MANUAL_AUD_TOMAN=
MANUAL_EUR_TOMAN=
MANUAL_AED_TOMAN=
MANUAL_OMR_TOMAN=
MANUAL_TRY_TOMAN=
DEEPSEEK_ENABLED=true
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=20000
MOJOAUTH_CLIENT_ID=
MOJOAUTH_CLIENT_SECRET=
MOJOAUTH_ISSUER=https://your-project.auth.mojoauth.com
MOJOAUTH_REDIRECT_URI=https://api.omoney.online/auth/mojoauth/callback
MOJOAUTH_SOCIAL_REDIRECT_URI=https://api.omoney.online/auth/social/callback
MOJOAUTH_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.omoney.online/auth/google/callback
