NODE_ENV=production
POSTGRES_DB=omoney
POSTGRES_USER=omoney
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://omoney:change-me@postgres:5432/omoney?schema=public
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace-with-64-char-secret
JWT_REFRESH_SECRET=replace-with-different-64-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=.omoney.online
COOKIE_SECURE=true
CORS_ORIGINS=https://omoney.online,https://www.omoney.online,https://admin.omoney.online
ADMIN_COOKIE_DOMAIN=.omoney.online
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
API_INTERNAL_URL=http://api:4000
UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_BYTES=10485760
MEDIA_ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4,video/webm
DEFAULT_ADMIN_EMAIL=info@omoney.online
DEFAULT_ADMIN_PASSWORD=change-me-now
WHATSAPP_NUMBER=96800000000
EXCHANGE_RATE_DEFAULT_PROVIDER=navasan
EXCHANGE_RATE_FALLBACK_PROVIDER=manual
EXCHANGE_RATE_REFRESH_SEC=60
EXCHANGE_RATE_STALE_AFTER_SEC=300
EXCHANGE_RATE_BUY_MARKUP_PERCENT=0.75
EXCHANGE_RATE_SELL_MARKUP_PERCENT=0.75
NAVASAN_ENABLED=true
NAVASAN_API_URL=http://api.navasan.tech/latest/
NAVASAN_API_KEY=
NAVASAN_RATE_UNIT=toman
MANUAL_USD_TOMAN=
MANUAL_CAD_TOMAN=
MANUAL_AUD_TOMAN=
MANUAL_EUR_TOMAN=
MANUAL_AED_TOMAN=
MANUAL_OMR_TOMAN=
MANUAL_TRY_TOMAN=
