{
  "name": "omoney-platform",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @omoney/api prisma:generate",
    "db:migrate": "pnpm --filter @omoney/api prisma:migrate",
    "db:seed": "pnpm --filter @omoney/api prisma:seed"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
